---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { temple } from '../data/temple';
---
<BaseLayout description="Discover Shri Digambar Mahaveer Jain Temple in Bengaluru. Find visitor information, temple details and contact information.">
  <SiteHeader active="home" />
  <main>
    <section class="hero">
      <div class="hero-pattern" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> A sanctuary for the soul</p>
          <h1>In stillness,<br />find the <em>path within.</em></h1>
          <p class="hero-description">Welcome to {temple.name}, a place to pause, offer prayers and reconnect with the timeless teachings of Jain dharma.</p>
          <div class="hero-actions"><a class="button button-primary" href="/visit">Plan your visit <span aria-hidden="true">↗</span></a><a class="text-link" href="/about">Discover the temple <span aria-hidden="true">→</span></a></div>
          <div class="hero-verse"><span class="verse-rule"></span><p>॥ अहिंसा परमो धर्मः ॥<small>Non-violence is the highest form of religion</small></p></div>
        </div>
        <div class="hero-art hero-murti">
          <img class="hero-murti-image" src="/images/main-murti.jpg" alt="Main Mahaveer murti at Shri Digambar Mahaveer Jain Temple" fetchpriority="high" />
          <div class="hero-photo-caption"><span>श्री महावीर स्वामी</span><small>SHRI DIGAMBAR MAHAVEER JAIN TEMPLE</small></div>
        </div>
      </div>
      <div class="hero-bottom"><div class="container"><span>WELCOME WITH AN OPEN HEART</span><span class="scroll-mark">↓</span><span>BENGALURU · KARNATAKA</span></div></div>
    </section>

    <section class="welcome-section section-pad">
      <div class="container welcome-grid">
        <div><p class="eyebrow"><span></span> A sacred place</p><h2>Rooted in faith.<br /><em>Open to all.</em></h2></div>
        <div class="welcome-copy"><p class="lead">A temple is more than a place of worship. It is a home for reflection, compassion and the shared values that bring a community together.</p><p>We welcome devotees and visitors to learn about the temple, its traditions and the path of right faith, right knowledge and right conduct.</p><a class="text-link" href="/about">Learn about the temple <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="visit-band">
      <div class="container visit-band-inner"><div><p class="eyebrow eyebrow-light"><span></span> Your visit</p><h2>Make space for<br /><em>peace and prayer.</em></h2></div><div class="visit-summary"><div><span class="summary-icon">⌖</span><p><strong>Find us</strong><small>{temple.address}</small></p></div><div class="summary-hours"><span class="summary-icon">◷</span><p><strong>Darshan timings</strong><small>Mon–Fri · 6:30 AM–12:00 PM, 5:00–8:00 PM</small><small>Sat–Sun · 6:30 AM–1:00 PM, 5:00–8:00 PM</small></p></div><a class="button button-light" href="/visit">Visitor information <span aria-hidden="true">→</span></a></div></div>
    </section>

    <section class="values-section section-pad"><div class="container"><div class="section-heading"><p class="eyebrow"><span></span> The Jain way</p><h2>Live with <em>awareness.</em></h2><p>Timeless principles that guide us toward a more compassionate life.</p></div><div class="values-grid"><article><span class="value-number">01</span><h3>Ahimsa</h3><p>Respect for all living beings, expressed through compassion in thought, word and action.</p></article><article><span class="value-number">02</span><h3>Anekantavada</h3><p>Humility to recognise that truth can be viewed from many perspectives.</p></article><article><span class="value-number">03</span><h3>Aparigraha</h3><p>Freedom through mindful living, simplicity and non-attachment.</p></article></div></div></section>

    <section class="gallery-section section-pad" id="gallery"><div class="container"><div class="gallery-heading"><div><p class="eyebrow"><span></span> Inside the temple</p><h2>A glimpse of <em>our sanctuary.</em></h2></div><p>Temple images shared by the community.</p></div><div class="gallery-grid"><figure class="gallery-card gallery-feature"><img src="/images/main-murti.jpg" alt="Main Mahaveer murti in the temple sanctum" loading="lazy" /><figcaption><span>01</span><strong>Shri Mahaveer Swami</strong></figcaption></figure><figure class="gallery-card"><img src="/images/temple-interior.jpg" alt="Interior view of the temple and its shrines" loading="lazy" /><figcaption><span>02</span><strong>Temple sanctum</strong></figcaption></figure><figure class="gallery-card"><img src="/images/jina-gallery.jpg" alt="Jina images in the temple shrine" loading="lazy" /><figcaption><span>03</span><strong>Sacred images</strong></figcaption></figure><figure class="gallery-card"><img src="/images/temple-exterior.png" alt="Exterior entrance of Shri Digambar Mahaveer Jain Temple (HAL)" loading="lazy" /><figcaption><span>04</span><strong>Temple entrance</strong></figcaption></figure></div></div></section>

    <section class="contact-strip"><div class="container contact-strip-inner"><div><p class="eyebrow"><span></span> We are here to help</p><h2>Planning a visit?</h2></div><p>For current timings, puja details or visitor enquiries, please get in touch with the temple.</p><a class="button button-primary" href="/visit#contact">Contact the temple <span aria-hidden="true">→</span></a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
