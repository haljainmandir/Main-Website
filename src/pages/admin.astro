---
import BaseLayout from '../layouts/BaseLayout.astro';
import { temple } from '../data/temple';

export const prerender = false;
---
<BaseLayout title={`Admin | ${temple.shortName}`} description="Temple event administration.">
  <main class="admin-shell">
    <header class="admin-header"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">श्री</span><span class="brand-copy"><strong>{temple.name}</strong><small>Event administration</small></span></a><a class="text-link" href="/events">View public events <span aria-hidden="true">↗</span></a></header>
    <section class="admin-panel" id="login-panel">
      <p class="eyebrow"><span></span> Committee access</p><h1>Sign in to manage events.</h1><p class="admin-intro">Use the administrator credentials configured for this website.</p>
      <form id="login-form" class="admin-form"><label>Username<input name="username" autocomplete="username" required /></label><label>Password<input name="password" type="password" autocomplete="current-password" required /></label><button class="button button-primary" type="submit">Sign in <span aria-hidden="true">→</span></button><p class="form-message" id="login-message" role="status"></p></form>
    </section>
    <section class="admin-dashboard" id="dashboard" hidden>
      <div class="admin-dashboard-heading"><div><p class="eyebrow"><span></span> Temple calendar</p><h1>Manage events.</h1></div><button class="button button-outline" id="logout-button" type="button">Sign out</button></div>
      <div class="admin-columns"><section class="admin-editor"><h2 id="editor-title">Add an event</h2><p class="admin-intro">Published events appear on the public Events page. Drafts stay private.</p>
        <form id="event-form" class="admin-form"><input type="hidden" name="id" />
          <label>Event title<input name="title" maxlength="120" required placeholder="e.g. Mahavir Janma Kalyanak" /></label>
          <label>Description<textarea name="summary" maxlength="800" rows="4" required placeholder="Share what devotees can expect."></textarea></label>
          <div class="admin-form-row"><label>Starts<input name="startsAt" type="datetime-local" required /></label><label>Ends <small>(optional)</small><input name="endsAt" type="datetime-local" /></label></div>
          <label>Location<input name="location" maxlength="180" required placeholder="Temple hall, Bengaluru" /></label>
          <label>Image URL <small>(optional — use a temple-approved image)</small><input name="imageUrl" type="url" maxlength="500" placeholder="https://…" /></label>
          <label>More information link <small>(optional)</small><input name="detailsUrl" type="url" maxlength="500" placeholder="https://…" /></label>
          <label>Visibility<select name="status"><option value="published">Publish on website</option><option value="draft">Save as draft</option></select></label>
          <div class="admin-form-actions"><button class="button button-primary" type="submit" id="save-event">Save event</button><button class="button button-outline" type="button" id="cancel-edit" hidden>Cancel edit</button></div>
          <p class="form-message" id="event-message" role="status"></p>
        </form>
      </section><section class="admin-event-list"><h2>Saved events</h2><p class="admin-intro">Edit, remove or change the visibility of an event.</p><div id="saved-events"><p class="muted">Loading events…</p></div></section></div>
    </section>
  </main>
</BaseLayout>

<script>
  const loginPanel = document.querySelector('#login-panel');
  const dashboard = document.querySelector('#dashboard');
  const loginForm = document.querySelector('#login-form');
  const loginMessage = document.querySelector('#login-message');
  const eventForm = document.querySelector('#event-form');
  const eventMessage = document.querySelector('#event-message');
  const savedEvents = document.querySelector('#saved-events');
  const editorTitle = document.querySelector('#editor-title');
  const cancelEdit = document.querySelector('#cancel-edit');
  const eventItems = new Map();

  const showMessage = (target, message, isError = false) => {
    target.textContent = message;
    target.classList.toggle('is-error', isError);
  };
  const jsonRequest = async (url, options = {}) => {
    const response = await fetch(url, { credentials: 'same-origin', ...options });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || 'The request could not be completed.');
    return body;
  };
  const asLocalDateTime = (value) => {
    if (!value) return '';
    const date = new Date(value);
    return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
  };
  const asIsoDateTime = (value) => value ? new Date(value).toISOString() : '';

  function resetEditor() {
    eventForm.reset();
    eventForm.elements.namedItem('id').value = '';
    editorTitle.textContent = 'Add an event';
    document.querySelector('#save-event').textContent = 'Save event';
    cancelEdit.hidden = true;
    showMessage(eventMessage, '');
  }

  function beginEdit(event) {
    eventForm.elements.namedItem('id').value = event.id;
    eventForm.elements.namedItem('title').value = event.title;
    eventForm.elements.namedItem('summary').value = event.summary;
    eventForm.elements.namedItem('startsAt').value = asLocalDateTime(event.startsAt);
    eventForm.elements.namedItem('endsAt').value = asLocalDateTime(event.endsAt);
    eventForm.elements.namedItem('location').value = event.location;
    eventForm.elements.namedItem('imageUrl').value = event.imageUrl;
    eventForm.elements.namedItem('detailsUrl').value = event.detailsUrl;
    eventForm.elements.namedItem('status').value = event.status;
    editorTitle.textContent = 'Edit event';
    document.querySelector('#save-event').textContent = 'Update event';
    cancelEdit.hidden = false;
    showMessage(eventMessage, '');
    eventForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function loadEvents() {
    const events = await jsonRequest('/api/events?includeDrafts=true');
    eventItems.clear();
    savedEvents.replaceChildren();
    if (!events.length) {
      const empty = document.createElement('p');
      empty.className = 'muted';
      empty.textContent = 'No events have been added yet.';
      savedEvents.append(empty);
      return;
    }
    events.sort((a, b) => Date.parse(a.startsAt) - Date.parse(b.startsAt));
    for (const event of events) {
      eventItems.set(event.id, event);
      const row = document.createElement('article');
      row.className = 'admin-event-row';
      const details = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = event.title;
      const meta = document.createElement('small');
      meta.textContent = `${new Date(event.startsAt).toLocaleString()} · ${event.location}`;
      const badge = document.createElement('span');
      badge.className = `status-badge ${event.status}`;
      badge.textContent = event.status === 'published' ? 'Published' : 'Draft';
      details.append(title, meta, badge);
      const actions = document.createElement('div');
      actions.className = 'admin-event-actions';
      const edit = document.createElement('button');
      edit.type = 'button';
      edit.className = 'text-link';
      edit.textContent = 'Edit';
      edit.addEventListener('click', () => beginEdit(event));
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'text-link delete-event';
      remove.textContent = 'Remove';
      remove.addEventListener('click', async () => {
        if (!window.confirm(`Remove “${event.title}” from the event list?`)) return;
        try {
          await jsonRequest(`/api/events/${encodeURIComponent(event.id)}`, { method: 'DELETE' });
          if (eventForm.elements.namedItem('id').value === event.id) resetEditor();
          await loadEvents();
        } catch (error) {
          showMessage(eventMessage, error.message, true);
        }
      });
      actions.append(edit, remove);
      row.append(details, actions);
      savedEvents.append(row);
    }
  }

  async function openDashboard() {
    loginPanel.hidden = true;
    dashboard.hidden = false;
    try {
      await loadEvents();
    } catch (error) {
      showMessage(eventMessage, error.message, true);
    }
  }

  jsonRequest('/api/admin/session').then((session) => {
    if (session.authenticated) return openDashboard();
    if (!session.configured) showMessage(loginMessage, 'Admin credentials are not configured on this server yet.', true);
  }).catch(() => showMessage(loginMessage, 'Could not check the admin session.', true));

  loginForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const values = new FormData(loginForm);
    try {
      await jsonRequest('/api/admin/login', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: values.get('username'), password: values.get('password') }),
      });
      showMessage(loginMessage, '');
      loginForm.reset();
      await openDashboard();
    } catch (error) {
      showMessage(loginMessage, error.message, true);
    }
  });

  eventForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const values = new FormData(eventForm);
    const id = values.get('id');
    const payload = Object.fromEntries(values.entries());
    payload.startsAt = asIsoDateTime(payload.startsAt);
    payload.endsAt = asIsoDateTime(payload.endsAt);
    try {
      await jsonRequest(id ? `/api/events/${encodeURIComponent(id)}` : '/api/events', {
        method: id ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
      });
      resetEditor();
      showMessage(eventMessage, 'Event saved.');
      await loadEvents();
    } catch (error) {
      showMessage(eventMessage, error.message, true);
    }
  });

  cancelEdit.addEventListener('click', resetEditor);
  document.querySelector('#logout-button').addEventListener('click', async () => {
    await jsonRequest('/api/admin/logout', { method: 'POST' });
    dashboard.hidden = true;
    loginPanel.hidden = false;
  });
</script>
